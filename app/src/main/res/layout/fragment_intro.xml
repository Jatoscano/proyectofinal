<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.fragments.intro.IntroFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_margin="20dp"
        android:padding="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp"
            android:gravity="center"
            android:textSize="@dimen/txt_size_text_3"
            android:textColorHint="@color/black"
            android:fontFamily="@font/kanit_bold"
            android:hint="Bienvenido, eres nuevo?. Esta esa una nueva experiencia para ti..."
            android:background="@drawable/shape_text"/>

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/animationView"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_margin="10dp"
            android:layout_gravity="center"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            app:lottie_rawRes="@raw/intro"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp"
            android:textSize="@dimen/txt_size_text_3"
            android:textColorHint="@color/black"
            android:fontFamily="@font/kanit_bold"
            android:hint="Ya eres Usuario?. Que bien!! ingresa aqui.."
            android:background="@drawable/shape_text"/>

        <Button
            android:id="@+id/btn_intro_log_in"
            android:layout_width="240dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:hint="Ingreso de Usuarios"
            android:textStyle="italic"
            android:textSize="@dimen/txt_size_text_4"
            android:textColorHint="@color/black"
            android:backgroundTint="@color/transparent"
            android:layout_margin="20dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp"
            android:textSize="@dimen/txt_size_text_3"
            android:textColorHint="@color/black"
            android:fontFamily="@font/kanit_bold"
            android:hint="Oh eres nuevo?. Toma este camino. Ingresa aqui.."
            android:background="@drawable/shape_text"/>

        <Button
            android:id="@+id/btn_intro_sign_in"
            android:layout_width="200dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:hint="Resgirtrarse"
            android:textStyle="italic"
            android:textSize="@dimen/txt_size_text_4"
            android:textColorHint="@color/black"
            android:backgroundTint="@color/transparent"/>

    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>